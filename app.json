{
  "expo": {
    "name": "IBVI Church",
    "slug": "ibvi-church",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/dd00c7ed-9156-4133-be28-3c7c771d73b9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.ibvi.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O IBVI usa suas fotos para você escolher a imagem do seu perfil.",
          "cameraPermission": "O IBVI usa a câmera para você tirar a foto do seu perfil."
        }
      ],
      "expo-secure-store",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EE",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#241710"
          }
        }
      ]
    ],
    "android": {
      "package": "br.com.ibvi.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "dd00c7ed-9156-4133-be28-3c7c771d73b9"
      }
    },
    "owner": "matheusivi"
  }
}
